# ─────────────────────────────────────────────────────────────────────────────
# Environment Variables Template — Trusted Legal Access Platform
# ─────────────────────────────────────────────────────────────────────────────
# HOW TO USE:
#   1. Frontend: copy this template to  frontend/.env.local  and populate values
#   2. Backend:  copy this template to  backend/.env         and populate values
#   NEVER commit files containing real credentials. Only .env.example is tracked.
#
# CONSOLES:
#   Firebase Console:      https://console.firebase.google.com
#   Google Cloud Console:  https://console.cloud.google.com
# ─────────────────────────────────────────────────────────────────────────────

# ══════════════════════════════════════════════════════════════════════════════
# FRONTEND — Next.js (frontend/.env.local)
# NEXT_PUBLIC_ prefix is exposed to the browser.
# ══════════════════════════════════════════════════════════════════════════════

# Firebase Web App Configuration
# Firebase Console → Project Settings → General → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=REPLACE_WITH_YOUR_FIREBASE_WEB_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=789551922996
NEXT_PUBLIC_FIREBASE_APP_ID=1:789551922996:web:d4b590a96d20e14506ef61

# Firebase App Check — Localhost Development Debug Token
# Required for running Firebase AI Logic (Gemini 3.8 Flash) and Firestore locally.
# Firebase Console → Build → App Check → Apps → Manage debug tokens
# NEVER commit this token. DO NOT deploy this to any production environment.
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=REPLACE_WITH_LOCAL_APP_CHECK_DEBUG_TOKEN

# Firebase App Check — Production Attestation (reCAPTCHA Enterprise)
# Set ONLY in production environments.
# DO NOT add localhost to your production reCAPTCHA Enterprise domain list.
# NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_KEY=

# Backend Service URL
# Local development: http://localhost:8000
# Cloud Run: https://<service-name>-<hash>-<region>.a.run.app
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000


# ══════════════════════════════════════════════════════════════════════════════
# BACKEND — FastAPI Python (backend/.env)
# These values are confidential server-side settings, NEVER sent to the client.
# ══════════════════════════════════════════════════════════════════════════════

# Environment: development | staging | production
ENVIRONMENT=development

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Debug mode (must be false in production)
DEBUG=false

# CORS — comma-separated list of allowed origins
# Local development: http://localhost:3000,http://127.0.0.1:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Request body size limit in bytes (default: 1 MB = 1048576)
MAX_REQUEST_SIZE_BYTES=1048576

# Rate limiting (requests per minute per client IP)
RATE_LIMIT_PER_MINUTE=60

# Groq fallback provider (server-side only; never exposed to the browser)
GROQ_API_KEY=REPLACE_WITH_GROQ_API_KEY

# ── Future Backend Credentials ────────────────────────────────────────────────
# Google Cloud / Firebase Admin credentials for server-side operations
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_CLOUD_PROJECT=promptwars-legal-ai
