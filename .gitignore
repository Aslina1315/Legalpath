frontend/npm-debug.log*
frontend/yarn-error.log
frontend/yarn-debug.log*
frontend/.pnpm-debug.log*
*.tsbuildinfo
next-env.d.ts

# ─── Python / Backend ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pdb
*.so
.venv/
venv/
backend/.venv/
backend/venv/
.uv/
dist/
build/
*.egg-info/
.eggs/
*.egg
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.hypothesis/

