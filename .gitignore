# ─── Environment & Secrets ───────────────────────────────────────────────────
# NEVER commit real credentials or environment files
.env
.env.local
.env.*.local
.env.development
.env.staging
.env.production
*.env

# Keep the examples (no real values inside)
!.env.example
!frontend/.env.local.example
!backend/.env.example

# ─── Node / Frontend ─────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/dist/
