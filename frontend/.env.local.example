# ─────────────────────────────────────────────────────────────────────────────
# Frontend Environment Variables — Trusted Legal Access Platform
# ─────────────────────────────────────────────────────────────────────────────
# Instructions:
# 1. Copy this file to frontend/.env.local:
#      cp .env.local.example .env.local
# 2. Populate values from your Firebase Project Console.
# 3. DO NOT commit .env.local to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Firebase Web App Configuration ──────────────────────────────────────────
# Location: Firebase Console → Project settings → General → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Firebase App Check — Local Development Debug Token ──────────────────────
# Required for localhost Firebase AI Logic (Gemini) and Firestore requests.
#
# Steps to generate for local development:
# 1. Open Firebase Console → Build → App Check → Apps tab.
# 2. Select your registered web app → Click "Manage debug tokens" from the menu.
# 3. Generate a new debug token and add it below.
#
# WARNING: NEVER commit this token. DO NOT use debug tokens in production.
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=

# ─── Firebase App Check — Production (reCAPTCHA Enterprise) ──────────────────
# Set ONLY in production environments.
# DO NOT add localhost to your production reCAPTCHA domain list.
# NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_KEY=

# ─── Backend Service URL ─────────────────────────────────────────────────────
# Local development default: http://localhost:8000
# Cloud Run production default: https://<service-name>-<hash>-<region>.a.run.app
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
